# Copiá este archivo como .env y completá los valores reales.
# El archivo .env nunca se sube a GitHub (está en .gitignore).

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# Es secreta: solo va en .env y en las variables de Railway, nunca en el código.
SUPABASE_KEY=
